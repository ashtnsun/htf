# Copy to .env.local for local development. Every variable is optional: the site builds and
# runs with none of them. On Vercel, set them in Project Settings -> Environment Variables.

# Canonical origin used in metadata, Open Graph URLs and the sitemap.
# Defaults to the Vercel production URL (VERCEL_PROJECT_PRODUCTION_URL) or localhost.
NEXT_PUBLIC_SITE_URL=

# Contact form -> Supabase table public.contact_messages; nonprofit intake form ->
# public.nonprofit_inquiries (supabase/migrations/). Server-side only: never expose the
# service role key with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contact + intake forms -> notification email through Resend (https://resend.com). CONTACT_FROM must
# be a sender on a domain verified in Resend; the resend.dev default only delivers to the
# Resend account owner, which is fine for testing.
RESEND_API_KEY=
CONTACT_INBOX=
CONTACT_FROM="Hack the Future website <onboarding@resend.dev>"

# Application portal (Phase 2). The portal signs people in with Supabase Auth (email code or
# magic link) using the anon / publishable key and the same SUPABASE_URL as above; it is
# server-side only here because every call goes through server actions.
# NEXT_PUBLIC_APPLY_MODE=portal switches /apply from the external-form redirect to the
# portal (set it on a Vercel preview for the dry run, then on production after it passes).
SUPABASE_ANON_KEY=
NEXT_PUBLIC_APPLY_MODE=external
