# Copy to .env.local for local development. Every variable is optional: the site builds and
# runs with none of them. On Vercel, set them in Project Settings -> Environment Variables.

# Canonical origin used in metadata, Open Graph URLs and the sitemap.
# Defaults to the Vercel production URL (VERCEL_PROJECT_PRODUCTION_URL) or localhost.
NEXT_PUBLIC_SITE_URL=

# Portfolio Night (/portfolio, /portfoliohost) is the one part of the site with a database.
# Without these, those pages say they are not connected and everything else is unaffected.
# Local values: `supabase status -o env` (API_URL, ANON_KEY, SERVICE_ROLE_KEY). Set them for
# the build too: next.config.ts allows screenshots from the SUPABASE_URL host.
SUPABASE_URL=
# Public; handed to the goals board for Realtime.
SUPABASE_ANON_KEY=
# Server only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The host's password for /portfoliohost.
PORTFOLIO_HOST_PASSWORD=
# Optional: Microlink's paid endpoint for the screenshots (the free one allows ~50 a day).
MICROLINK_API_KEY=

# Applications go through the Google Form linked in content/site.ts (season.applyFormUrl)
# and messages by email. The variables of the parked application portal and site forms
# (Supabase Auth, Resend) are documented in parked/README.md.
